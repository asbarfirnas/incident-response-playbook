<!--
  Custom Wazuh Detection Rules
  Cyber Security Incident Playbook — Group Assignment
  Covers: T1566.001, T1053.005, T1546.003, T1041
  Requires: Sysmon integration, Windows Event Forwarding to Wazuh
-->

<!-- ============================================================
     INCIDENT #001 — Spearphishing Attachment via LNK
     MITRE ATT&CK: T1566.001, T1059.001, T1059.003, T1105
     ============================================================ -->
<group name="sysmon,initial_access,malware_execution,">

  <rule id="100001" level="12">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.parentImage">\\cmd\.exe</field>
    <field name="win.eventdata.commandLine" type="pcre2">powershell\.exe.*wget.*http.*\.exe</field>
    <description>Suspicious Process Creation: PowerShell downloading and executing an EXE via CMD (Possible Spearphishing/LNK payload)</description>
    <mitre>
      <id>T1566.001</id>
      <id>T1059.001</id>
      <id>T1059.003</id>
      <id>T1105</id>
    </mitre>
  </rule>

</group>


<!-- ============================================================
     INCIDENT #004 — Exfiltration Over C2 Channel
     MITRE ATT&CK: T1041
     ============================================================ -->
<group name="exfiltration,curl,mitre_T1041">

  <rule id="300004" level="12">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i).*curl\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(-F|--form|-d|--data|--upload-file).*(http:\/\/|https:\/\/)</field>
    <description>MITRE ATT&CK T1041: Exfiltration via Exfiltration Over C2 Channel — curl.exe uploading data over HTTP/S</description>
    <mitre>
      <id>T1041</id>
    </mitre>
  </rule>

</group>
